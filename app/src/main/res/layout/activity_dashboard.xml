<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="?android:attr/buttonBarButtonStyle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#7893A3">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#202A35">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/courtscheduler"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/court_booking_system"
            android:textColor="#F47B20"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- MAIN CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- WELCOME -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:padding="15dp"
                android:gravity="center_vertical"
                android:background="#AFC1CC">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/welcome_nuser_name"
                    android:textColor="#17202A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <Button
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:text="@string/logout"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#263442"
                    tools:ignore="HardcodedText" />

            </LinearLayout>


            <!-- COURT AVAILABILITY -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/court_availability"
                android:textColor="#17202A"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


            <!-- COURT 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E8EDF0">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/court_1"
                        android:textColor="#17202A"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/indoor_available"
                        android:textColor="#00796B"
                        android:textSize="14sp" />

                </LinearLayout>

                <Button
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#263442"
                    android:text="@string/book"
                    android:textColor="#FFFFFF"
                    tools:ignore="DuplicateSpeakableTextCheck" />

            </LinearLayout>


            <!-- COURT 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E8EDF0">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/court_2"
                        android:textColor="#17202A"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/outdoor_booked"
                        android:textColor="#BF360C"
                        android:textSize="14sp" />

                </LinearLayout>

                <Button
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#D66A28"
                    android:text="@string/Book"
                    android:textColor="#212121" />

            </LinearLayout>


            <!-- COURT 3 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E8EDF0">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/court_3"
                        android:textColor="#17202A"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/outdoor_available"
                        android:textColor="#00796B"
                        android:textSize="14sp" />

                </LinearLayout>

                <Button
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#263442"
                    android:text="@string/Book1"
                    android:textColor="#FFFFFF" />

            </LinearLayout>


            <!-- BOOKING -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/book_a_court"
                android:textColor="#17202A"
                android:textSize="20sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="15dp"
                android:orientation="vertical"
                android:background="#E8EDF0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_date"
                    android:textColor="#17202A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="5dp"
                    android:text="@string/may_22_2026"
                    android:textColor="#17202A"
                    android:backgroundTint="#FFFFFF"
                    tools:ignore="VisualLintButtonSize" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/select_time"
                    android:textColor="#17202A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">

                    <Button
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:text="@string/_9_00_am"
                        android:layout_marginEnd="5dp"
                        android:backgroundTint="#F47B20"
                        tools:ignore="VisualLintButtonSize" />

                    <Button
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:text="@string/_10_00_am"
                        android:layout_marginStart="5dp"
                        android:backgroundTint="#FFFFFF"
                        tools:ignore="VisualLintButtonSize" />

                </LinearLayout>

            </LinearLayout>


            <!-- UPCOMING SESSIONS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"


                android:text="@string/my_upcoming_sessions"
                android:textColor="#17202A"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:orientation="vertical"
                android:background="#E8EDF0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/may_22_6_00_pm"
                    android:textColor="#17202A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/court_1_indoor"
                    android:textColor="#6B7280"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- FIND A GAME -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="20dp"
                android:padding="15dp"
                android:orientation="vertical"
                android:background="#AFC1CC">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/find_a_game"
                    android:textColor="#17202A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="130dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/find_game"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#263442" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- BOTTOM NAVIGATION -->

    <LinearLayout
        style="?android:attr/buttonBarButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:background="#202A35">

        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/home"
            android:textColor="#F47B20"
            android:backgroundTint="#202A35"
            tools:ignore="VisualLintButtonSize" />

        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/bookings"
            android:textColor="#FFFFFF"
            android:backgroundTint="#202A35"
            tools:ignore="VisualLintButtonSize" />

        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/courts"
            android:textColor="#FFFFFF"
            android:backgroundTint="#202A35"
            tools:ignore="VisualLintButtonSize" />

        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/account"
            android:textColor="#FFFFFF"
            android:backgroundTint="#202A35"
            tools:ignore="VisualLintButtonSize" />

    </LinearLayout>

</LinearLayout>